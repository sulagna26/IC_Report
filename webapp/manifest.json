{
  "_version": "1.59.0",
  "sap.app": {
    "id": "com.nn.finance.interinvoicingadmin",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.12.3",
      "toolsId": "12c5f3d7-fba3-4fdf-a78b-1fea21729752"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZGW_IC_INV_SRV/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "bpatrigger":{
        "uri": "bpa/workflow/rest/v1/workflow-instances",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "2.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "invadmin_semantic-display": {
          "semanticObject": "invadmin_semantic",
          "action": "display",
          "title": "{{flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "fullWidth": true,
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.120.6",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.suite.ui.generic.template": {},
        "sap.ui.comp": {},
        "sap.ui.generic.app": {},
        "sap.ui.table": {},
        "sap.ushell": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.nn.finance.interinvoicingadmin.i18n.i18n"
        }
      },
      "Overview": {
        "type": "sap.ui.model.json.JSONModel",
        "settings": {
            "defaultBindingMode": "TwoWay"
        },
        "preload": true
    },
    "Filter": {
        "type": "sap.ui.model.json.JSONModel"
    },
      "":  {
        "type": "sap.ui.model.odata.v2.ODataModel",
        "settings": {
            "defaultOperationMode": "Server",
            "defaultBindingMode": "OneWay",
            "defaultCountMode": "Inline",
            "useBatch": false
        },
        "dataSource": "mainService",
        "preload": true
    }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
          "routerClass": "sap.m.routing.Router",
          "viewType": "XML",
          "async": true,
          "viewPath": "com.nn.finance.interinvoicingadmin.view",
          "controlAggregation": "pages",
          "controlId": "app",
          "clearControlAggregation": false
      },
      "routes": [
          {
              "name": "RouteMain",
              "pattern": "RouteMain",
              "target": [
                  "TargetMain"
              ]
          }
      ],
      "targets": {
          "TargetMain": {
              "viewType": "XML",
              "transition": "slide",
              "clearControlAggregation": false,
              "viewId": "Main",
              "viewName": "Main"
          }
      }
  },
    "rootView": {
      "viewName": "com.nn.finance.interinvoicingadmin.view.Main",
      "type": "XML",
      "async": true,
      "id": "Main"
    }
  },

  "sap.cloud": {
    "public": true,
    "service": "comnnfinanceinterinvoicingadmin"
  }
}

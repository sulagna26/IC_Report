<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m">
	<Table
		growing="true"
		growingThreshold="1000"
		id="idTaskCollection"
		noDataText="{i18n>inv-form-li-noinvoices}"
		alternateRowColors="true"
		items="{Overview>/}">
		<headerToolbar>
				<OverflowToolbar >
					<ToolbarSpacer />
					<Button id="idExportXls" text="Export" enabled="false" tooltip="Export to excel" icon="sap-icon://excel-attachment" press="onDataExport" />
				</OverflowToolbar>
			</headerToolbar>
		<columns>
			<Column	hAlign="Begin">
				<Text text="{i18n>inv-form-invoiceflow}" />
			</Column>
			<Column	hAlign="Begin">
				<Text text="{i18n>inv-form-status}" />
			</Column>
			<Column minScreenWidth="Tablet" demandPopin="true" hAlign="Begin" >
				<Text text="{i18n>inv-form-initials}" />
			</Column>
			<Column hAlign="Begin" minScreenWidth="Tablet" demandPopin="true">
				<Text text="{i18n>inv-form-companycode}" />
			</Column>
			<Column minScreenWidth="Tablet" demandPopin="true" hAlign="Begin" >
				<Text text="{i18n>inv-form-initialsreceiver}" />
			</Column>
			<Column hAlign="Begin" minScreenWidth="Tablet" demandPopin="true">
				<Text text="{i18n>inv-form-companycodereceiver}" />
			</Column>
			<Column minScreenWidth="Tablet" hAlign="Begin" demandPopin="true">
				<Text text="{i18n>inv-form-li-amount}" />
			</Column>
			<Column minScreenWidth="Tablet" demandPopin="true">
				<Text text="{i18n>inv-form-created}" />
			</Column>
			<Column minScreenWidth="Tablet" demandPopin="true">
				<Text text="{i18n>inv-form-ordernumber}" />
			</Column>
			<Column minScreenWidth="Tablet" demandPopin="true">
				<Text text = "Cost Center"/>
			</Column>
			<Column minScreenWidth="Tablet" demandPopin="true">
				<Text text = "WBS"/>
			</Column>
		</columns>
		<items>
			<ColumnListItem vAlign="Middle" type="Inactive">
				<cells>
					<Text text="{ parts : ['Overview>startEvent/invoiceFlow'], formatter: '.formatter.formatInvoiceFlow'}"/>
					<!-- <Text text="{Overview>statustext}"/> -->
					<ObjectStatus text="{ parts : ['Overview>statustext', 'Overview>custom/approved'], formatter: '.formatter.formatStatus'}"
									  icon="{ parts:['Overview>statustext', 'Overview>custom/approved'], formatter: '.formatter.formatIcon' }"
									  state="{ parts:['Overview>statustext', 'Overview>custom/approved'], formatter: '.formatter.formatState' }">
					</ObjectStatus>
					<Text text="{Overview>startEvent/senderInitials}"/>
					<Text text="{Overview>startEvent/senderCcode}"/>
					<Text text="{Overview>startEvent/receiverInitials}"/>
					<Text text="{Overview>startEvent/receiverCcode}"/>
					<Text text="{
					  	path: 'Overview>startEvent/totalAmount',
					    type: 'sap.ui.model.type.Float',
					    formatOptions: {		
					    	maxFractionDigits : 2, 
							minFractionDigits : 2, 
				            groupingEnabled: 'true', 
 							groupingSeparator: '.',
 							decimalSeparator: ','
			        }} {Overview>startEvent/currency}"/>
					<Text text="{ path: 'Overview>createdat', type: 'sap.ui.model.type.Date', formatOptions: {pattern:'dd.MM.yyyy'}}"/>
					<ObjectStatus text="{Overview>custom/vbeln}" state="Success"></ObjectStatus>
					<Text text="{Overview>sndCostCenter}"/>
					<Text text="{Overview>sndWbs}"/>
				</cells>
			</ColumnListItem>
		</items>
	</Table>

</core:FragmentDefinition>